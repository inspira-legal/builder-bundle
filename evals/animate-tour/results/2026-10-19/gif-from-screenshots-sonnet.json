  "scenes": "<!doctype html>\n<!--\n  A first-steps tour scene for /bb:animate-tour, GIF mode.\n\n  `tour.mjs new <slug>` copies this file to ~/Motion/scenes/<slug>/index.html, beside the\n  Poppins fonts and icons.js. Write one <template data-step> per step inside <body>, in order.\n  Leave the \"DO NOT EDIT\" blocks alone: they mirror the app's tokens and keyframes\n  (references/pattern.md, sections 3 and 4).\n\n  Icons: an empty `i` element with data-icon=\"paper\" and class=\"ic ic-sm\". The name is a file\n  in the skill's assets/icons without the .svg; the step mounts it as the design system's SVG.\n\n  Contract with the studio (render.mjs, stills.mjs and tour.mjs record): window.DURATION,\n  window.READY and window.seek(t). Preview in a browser with index.html?play, or one step with\n  index.html?play&step=2.\n-->\n<html lang=\"pt-BR\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <title>Pesquisa tour</title>\n    <style>\n      @font-face {\n        font-family: Poppins;\n        font-weight: 400;\n        src: url(fonts/poppins-400.woff2);\n      }\n      @font-face {\n        font-family: Poppins;\n        font-weight: 500;\n        src: url(fonts/poppins-500.woff2);\n      }\n      @font-face {\n        font-family: Poppins;\n        font-weight: 600;\n        src: url(fonts/poppins-600.woff2);\n      }\n\n      /* ===== DO NOT EDIT: design system tokens (packages/ui/src/tailwind/theme.css) ===== */\n      :root {\n        --color-navy-base-dark: #070c20;\n        --color-neutral-1: #ffffff;\n        --color-neutral-2: #f6f7f9;\n        --color-neutral-3: #eef0f3;\n        --color-neutral-4: #e8e9ec;\n        --color-neutral-5: #dcdee0;\n        --color-neutral-6: #d0d3d6;\n        --color-neutral-7: #c1c4c7;\n        --color-neutral-8: #8e9399;\n        --color-neutral-9: #656c74;\n        --color-neutral-10: #363f49;\n        --color-navy-1: #2f3b6a;\n        --color-navy-2: #26325e;\n        --color-navy-3: #1c264f;\n        --color-navy-4: #151e42;\n        --color-navy-5: #0e1634;\n        --color-sky-1: #fafcff;\n        --color-sky-2: #ecf2fd;\n        --color-sky-3: #dbe6fa;\n        --color-sky-4: #cfdffc;\n        --color-sky-5: #bdd2fa;\n        --color-sky-6: #a8c3f5;\n        --color-sky-7: #91b3f3;\n        --color-sky-8: #7ca4ee;\n        --color-sky-9: #6a96ea;\n        --color-sky-10: #5187ec;\n        --color-success-2: #b7ede2;\n        --color-success-6: #0f947a;\n        --color-success-8: #057861;\n        --color-success-9: #046b57;\n        --color-warning-2: #ffe9bd;\n        --color-warning-6: #faad16;\n        --color-warning-7: #f0a10a;\n        --color-warning-8: #e39600;\n        --color-critical-2: #ffc7cd;\n        --color-critical-7: #bd081d;\n        --color-critical-8: #ab071a;\n        --gradient-4c-to: #2d3aa1;\n        --radius-xs: 4px;\n        --radius-sm: 8px;\n        --radius-md: 10px;\n        --radius-lg: 12px;\n        --radius-xl: 16px;\n        --ease-pop: cubic-bezier(0.25, 1, 0.5, 1);\n      }\n      * {\n        box-sizing: border-box;\n        margin: 0;\n        padding: 0;\n      }\n      html,\n      body {\n        background: var(--color-neutral-1);\n        overflow: hidden;\n      }\n      body {\n        font-family: Poppins, sans-serif;\n        color: var(--color-neutral-10);\n        -webkit-font-smoothing: antialiased;\n      }\n\n      /* The stage is the modal's art area: the 452px card less 24px of padding on each side,\n         by 212px. No border and no corner: that is the GIF's crop (the app's modal frame adds both). */\n      #stage {\n        position: relative;\n        width: 404px;\n        height: 212px;\n        overflow: hidden;\n        background: linear-gradient(to bottom, var(--color-sky-2), var(--color-neutral-1));\n      }\n      #stage > .step {\n        position: absolute;\n        inset: 0;\n      }\n\n      /* Type (text-*) */\n      .caption-sm {\n        font-size: 11px;\n        line-height: 1.5;\n      }\n      .caption {\n        font-size: 12px;\n        line-height: 1.5;\n      }\n      .body-sm {\n        font-size: 13px;\n        line-height: 1.5;\n      }\n      .body {\n        font-size: 14px;\n        line-height: 1.6;\n      }\n      .regular {\n        font-weight: 400;\n      }\n      .medium {\n        font-weight: 500;\n      }\n      .semibold {\n        font-weight: 600;\n      }\n      .upper {\n        text-transform: uppercase;\n      }\n      .italic {\n        font-style: italic;\n      }\n      .tight {\n        line-height: 1.25;\n      }\n      .truncate {\n        overflow: hidden;\n        text-overflow: ellipsis;\n        white-space: nowrap;\n        min-width: 0;\n      }\n      .nowrap {\n        white-space: nowrap;\n      }\n\n      /* Illustration aliases (the same consts every StepArt.tsx declares at its top) */\n      .t-dark {\n        color: var(--color-neutral-10);\n      }\n      .t-muted {\n        color: var(--color-neutral-9);\n      }\n      .t-faint {\n        color: var(--color-neutral-8);\n      }\n      .t-accent {\n        color: var(--color-sky-10);\n      }\n      .t-indigo {\n        color: var(--gradient-4c-to);\n      }\n      .t-white {\n        color: var(--color-neutral-1);\n      }\n      .b {\n        border: 1px solid var(--color-neutral-5);\n      }\n      .b-soft {\n        border: 1px solid var(--color-neutral-3);\n      }\n      .b-dash {\n        border: 1.5px dashed var(--color-neutral-6);\n      }\n      .bg-white {\n        background: var(--color-neutral-1);\n      }\n      .bg-table {\n        background: var(--color-neutral-2);\n      }\n      .bg-lavender {\n        background: var(--color-sky-2);\n      }\n\n      /* Layout */\n      .fill {\n        width: 100%;\n        height: 100%;\n      }\n      .center {\n        display: flex;\n        align-items: center;\n        justify-content: center;\n      }\n      .col {\n        display: flex;\n        flex-direction: column;\n      }\n      .row {\n        display: flex;\n        align-items: center;\n      }\n      .grow {\n        flex: 1;\n        min-width: 0;\n      }\n      .rel {\n        position: relative;\n      }\n      .abs {\n        position: absolute;\n      }\n      .r-xs {\n        border-radius: var(--radius-xs);\n      }\n      .r-sm {\n        border-radius: var(--radius-sm);\n      }\n      .r-md {\n        border-radius: var(--radius-md);\n      }\n      .r-lg {\n        border-radius: var(--radius-lg);\n      }\n      .r-xl {\n        border-radius: var(--radius-xl);\n      }\n      .r-full {\n        border-radius: 9999px;\n      }\n\n      /* Recurring pieces */\n      .cta {\n        display: inline-flex;\n        align-items: center;\n        gap: 6px;\n        height: 38px;\n        padding: 0 18px;\n        border-radius: var(--radius-md);\n        background: var(--color-navy-3);\n        color: var(--color-neutral-1);\n        font-size: 13px;\n        font-weight: 500;\n        white-space: nowrap;\n      }\n      .pill {\n        display: inline-flex;\n        align-items: center;\n        gap: 4px;\n        padding: 2px 6px;\n        border-radius: 9999px;\n        font-size: 11px;\n        font-weight: 500;\n        white-space: nowrap;\n      }\n      .ic {\n        display: inline-block;\n        flex-shrink: 0;\n        vertical-align: middle;\n      }\n      .ic-xs {\n        width: 12px;\n        height: 12px;\n      }\n      .ic-sm {\n        width: 16px;\n        height: 16px;\n      }\n      .ic-md {\n        width: 20px;\n        height: 20px;\n      }\n      .ic svg {\n        width: 100%;\n        height: 100%;\n        display: block;\n      }\n      .ic-missing {\n        outline: 2px solid #ff00ff;\n      }\n      .cursor {\n        position: absolute;\n        width: 20px;\n        height: 20px;\n        filter: drop-shadow(0 2px 3px rgba(7, 12, 33, 0.3));\n        animation: tour-cursorTap 1.6s ease-in-out infinite;\n      }\n\n      /* ===== DO NOT EDIT: the motion vocabulary (the keyframes in each *TourDialog/index.tsx) ===== */\n      @keyframes tour-stepIn {\n        from {\n          opacity: 0;\n          transform: translateY(6px);\n        }\n        to {\n          opacity: 1;\n          transform: none;\n        }\n      }\n      @keyframes tour-pop {\n        0% {\n          opacity: 0;\n          transform: translateY(6px) scale(0.94);\n        }\n        60% {\n          opacity: 1;\n        }\n        100% {\n          opacity: 1;\n          transform: none;\n        }\n      }\n      @keyframes tour-cursorTap {\n        0%,\n        100% {\n          transform: translate(0, 0);\n        }\n        45% {\n          transform: translate(-2px, -2px);\n        }\n        55% {\n          transform: translate(1px, 1px);\n        }\n      }\n      @keyframes tour-glowPulse {\n        0%,\n        100% {\n          box-shadow: 0 0 0 0 rgba(106, 151, 235, 0.45);\n        }\n        50% {\n          box-shadow: 0 0 0 7px rgba(106, 151, 235, 0);\n        }\n      }\n      @keyframes tour-checkPop {\n        from {\n          opacity: 0;\n          transform: scale(0.4);\n        }\n        to {\n          opacity: 1;\n          transform: none;\n        }\n      }\n      @keyframes tour-sheetRise {\n        from {\n          opacity: 0;\n          transform: translateY(10px);\n        }\n        to {\n          opacity: 1;\n          transform: none;\n        }\n      }\n      .step-in {\n        animation: tour-stepIn 0.3s var(--ease-pop) both;\n      }\n      .pop {\n        opacity: 0;\n        animation: tour-pop 0.4s var(--ease-pop) forwards;\n      }\n      .glow {\n        animation: tour-glowPulse 2s ease-in-out infinite;\n      }\n      .check-pop {\n        opacity: 0;\n        animation: tour-checkPop 0.28s var(--ease-pop) forwards;\n      }\n      .sheet-rise {\n        animation: tour-sheetRise 0.4s var(--ease-pop) both;\n      }\n      /* Each class above declares the whole `animation`, so two of them on one element fight and\n         the last one wins (a .pop.glow would stay invisible). These pairs run both. For any other\n         pair, wrap: the entrance on the parent, the loop on the child. */\n      .pop.glow {\n        animation:\n          tour-pop 0.4s var(--ease-pop) forwards,\n          tour-glowPulse 2s ease-in-out infinite;\n      }\n      .step-in.glow {\n        animation:\n          tour-stepIn 0.3s var(--ease-pop) both,\n          tour-glowPulse 2s ease-in-out infinite;\n      }\n      /* Entrance delay: style=\"animation-delay:.15s\" (steps of .15s). */\n      /* ===== end of the DO NOT EDIT block ===== */\n\n      /* This feature's own keyframes (prefix tour-, see pattern.md \"A new movement\") */\n    </style>\n  </head>\n  <body>\n    <div id=\"stage\" aria-hidden=\"true\"></div>\n\n    <!--\n      One <template> per step, in order. Attributes:\n        data-step      the step's position, from 1\n        data-title     the step's title (documentation only; it does not show in the GIF)\n        data-duration  seconds the step stays on screen (default 4)\n      A template fills the whole stage (404x212). Center it with class=\"fill center\".\n\n      The cursor is always this SVG. Put it inside a <span class=\"rel\" style=\"display:inline-flex\">\n      that wraps the target, anchored at the bottom right corner: style=\"right:-14px;bottom:-14px\"\n      for a 38px button, \"right:-10px;bottom:-10px\" for a button of 32px or less, and\n      \"right:6px;bottom:-8px\" inside a table cell.\n      <svg class=\"cursor\" viewBox=\"0 0 24 24\" fill=\"#070c20\" stroke=\"#ffffff\" stroke-width=\"1.2\"><path d=\"M5 3l6.5 16 2.2-6.6L20 10.5 5 3z\"/></svg>\n    -->\n\n    <template data-step=\"1\" data-title=\"Comece uma nova pesquisa\" data-duration=\"4\">\n      <div class=\"fill center\">\n        <div\n          class=\"b-dash r-xl bg-white col step-in\"\n          style=\"width: 220px; padding: 18px; align-items: center; gap: 8px\"\n        >\n          <div\n            class=\"r-lg center t-muted\"\n            style=\"width: 40px; height: 40px; background: var(--color-neutral-3)\"\n          >\n            <i data-icon=\"search\" class=\"ic ic-md\"></i>\n          </div>\n          <span class=\"caption-sm t-muted\" style=\"margin-bottom: 4px\">Nenhuma pesquisa ainda</span>\n          <span class=\"rel\" style=\"display: inline-flex\">\n            <span class=\"cta glow\"><i data-icon=\"plus\" class=\"ic ic-sm\"></i>Nova pesquisa</span>\n            <svg\n              class=\"cursor\"\n              style=\"right: -14px; bottom: -14px\"\n              viewBox=\"0 0 24 24\"\n              fill=\"#070c20\"\n              stroke=\"#ffffff\"\n              stroke-width=\"1.2\"\n            >\n              <path d=\"M5 3l6.5 16 2.2-6.6L20 10.5 5 3z\" />\n            </svg>\n          </span>\n        </div>\n      </div>\n    </template>\n\n    <template data-step=\"2\" data-title=\"Digite a palavra-chave e filtre\" data-duration=\"4\">\n      <div class=\"fill center\">\n        <div class=\"col\" style=\"width: 336px; gap: 10px\">\n          <div\n            class=\"b r-md bg-white row pop\"\n            style=\"height: 36px; padding: 0 12px; gap: 8px\"\n          >\n            <i data-icon=\"search\" class=\"ic ic-sm t-faint\"></i>\n            <span class=\"body-sm t-dark\">rescisão de contrato</span>\n          </div>\n          <div class=\"row\" style=\"gap: 6px\">\n            <span\n              class=\"pill pop\"\n              style=\"\n                animation-delay: 0.15s;\n                padding: 4px 8px;\n                border: 1px solid var(--color-sky-4);\n                background: var(--color-sky-1);\n                box-shadow: 0 0 0 3px rgba(106, 151, 235, 0.15);\n                color: var(--color-sky-10);\n              \"\n              >Processos</span\n            >\n            <span\n              class=\"pill pop b bg-white t-dark\"\n              style=\"animation-delay: 0.3s; padding: 4px 8px\"\n              >Documentos</span\n            >\n            <span\n              class=\"pill pop\"\n              style=\"\n                animation-delay: 0.45s;\n                padding: 4px 8px;\n                border: 1px solid var(--color-sky-4);\n                background: var(--color-sky-1);\n                box-shadow: 0 0 0 3px rgba(106, 151, 235, 0.15);\n                color: var(--color-sky-10);\n              \"\n              >Tribunal: TJSP</span\n            >\n            <span\n              class=\"pill pop b bg-white t-dark\"\n              style=\"animation-delay: 0.6s; padding: 4px 8px\"\n              >Período</span\n            >\n          </div>\n          <div style=\"margin-top: 6px\">\n            <span class=\"rel\" style=\"display: inline-flex\">\n              <span\n                class=\"cta pop glow\"\n                style=\"height: 32px; padding: 0 14px; animation-delay: 0.75s\"\n                ><i data-icon=\"search\" class=\"ic ic-sm\"></i>Pesquisar</span\n              >\n              <svg\n                class=\"cursor\"\n                style=\"right: -10px; bottom: -10px\"\n                viewBox=\"0 0 24 24\"\n                fill=\"#070c20\"\n                stroke=\"#ffffff\"\n                stroke-width=\"1.2\"\n              >\n                <path d=\"M5 3l6.5 16 2.2-6.6L20 10.5 5 3z\" />\n              </svg>\n            </span>\n          </div>\n        </div>\n      </div>\n    </template>\n\n    <template data-step=\"3\" data-title=\"Veja os resultados\" data-duration=\"4\">\n      <div class=\"fill center\">\n        <div class=\"col\" style=\"width: 344px; gap: 6px\">\n          <span class=\"body-sm semibold t-dark pop\" style=\"margin-bottom: 2px\">3 resultados</span>\n          <div\n            class=\"b-soft r-lg bg-white row pop\"\n            style=\"animation-delay: 0.15s; padding: 6px 12px; gap: 10px\"\n          >\n            <i data-icon=\"court\" class=\"ic ic-sm t-muted\"></i>\n            <div class=\"col grow\">\n              <div class=\"row\" style=\"gap: 6px\">\n                <span class=\"body-sm semibold t-dark truncate\">Marina Alves x Imobiliária Aurora</span>\n                <span\n                  class=\"pill\"\n                  style=\"background: var(--color-success-2); color: var(--color-success-9)\"\n                  >Ativo</span\n                >\n              </div>\n              <span class=\"caption-sm t-muted truncate\">Processo · TJSP</span>\n            </div>\n          </div>\n          <div\n            class=\"b-soft r-lg bg-white row pop\"\n            style=\"animation-delay: 0.3s; padding: 6px 12px; gap: 10px\"\n          >\n            <i data-icon=\"court\" class=\"ic ic-sm t-muted\"></i>\n            <div class=\"col grow\">\n              <div class=\"row\" style=\"gap: 6px\">\n                <span class=\"body-sm semibold t-dark truncate\">Paulo Nunes x Construtora Horizonte</span>\n                <span\n                  class=\"pill\"\n                  style=\"background: var(--color-success-2); color: var(--color-success-9)\"\n                  >Ativo</span\n                >\n              </div>\n              <span class=\"caption-sm t-muted truncate\">Processo · TJSP</span>\n            </div>\n          </div>\n          <div\n            class=\"b-soft r-lg bg-white row pop\"\n            style=\"animation-delay: 0.45s; padding: 6px 12px; gap: 10px\"\n          >\n            <i data-icon=\"paper-pdf\" class=\"ic ic-sm t-muted\"></i>\n            <div class=\"col grow\">\n              <span class=\"body-sm semibold t-dark truncate\">Parecer_Locacao_01.pdf</span>\n              <span class=\"caption-sm t-muted truncate\">Documento · Pasta Contratos</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </template>\n\n    <script src=\"icons.js\"></script>\n    <script>\n      // ===== DO NOT EDIT: the scene contract =====\n      // A step mounts from scratch, the way each step is a fresh component in the app, and seek\n      // pauses every CSS animation at the asked time. Same t, same pixels.\n      const templates = [...document.querySelectorAll(\"template[data-step]\")].sort(\n        (a, b) => Number(a.dataset.step) - Number(b.dataset.step),\n      );\n      const stage = document.getElementById(\"stage\");\n      const icons = window.ICONS || {};\n      window.MISSING_ICONS = [];\n      window.STEPS = templates.map((t) => Number(t.dataset.duration || 4));\n      window.DURATION = window.STEPS.reduce((a, b) => a + b, 0);\n\n      let mounted = -1;\n      const mount = (i) => {\n        if (i === mounted) return;\n        const wrap = document.createElement(\"div\");\n        wrap.className = \"step\";\n        wrap.appendChild(templates[i].content.cloneNode(true));\n        for (const el of wrap.querySelectorAll(\"i[data-icon]\")) {\n          const svg = icons[el.dataset.icon];\n          if (svg) el.innerHTML = svg;\n          else {\n            el.classList.add(\"ic-missing\");\n            window.MISSING_ICONS.push(el.dataset.icon);\n          }\n        }\n        stage.replaceChildren(wrap);\n        mounted = i;\n      };\n      const freeze = (t) =>\n        document.getAnimations().forEach((a) => {\n          a.pause();\n          a.currentTime = t * 1000;\n        });\n\n      // Seconds after which every finite animation of step i (pop, stepIn, checkPop...) has settled.\n      window.settledAt = (i) => {\n        mount(i);\n        return (\n          Math.max(\n            0,\n            ...document.getAnimations().map((a) => {\n              const end = a.effect.getComputedTiming().endTime;\n              return Number.isFinite(end) ? end : 0;\n            }),\n          ) / 1000\n        );\n      };\n      window.seekStep = (i, t) => {\n        mount(i);\n        freeze(t);\n      };\n      window.seek = (t) => {\n        let i = 0;\n        let start = 0;\n        while (i < window.STEPS.length - 1 && t >= start + window.STEPS[i])\n          start += window.STEPS[i++];\n        window.seekStep(i, t - start);\n      };\n      window.READY = Promise.all(\n        [\"400\", \"500\", \"600\"].map((w) => document.fonts.load(`${w} 12px Poppins`)),\n      );\n\n      // Preview in a normal browser: index.html?play, or index.html?play&step=2 to hold one step.\n      const query = new URLSearchParams(location.search);\n      if (query.has(\"play\"))\n        window.READY.then(() => {\n          const only = query.has(\"step\") ? Number(query.get(\"step\")) - 1 : -1;\n          const t0 = performance.now();\n          const loop = () => {\n            const t = (performance.now() - t0) / 1000;\n            if (only >= 0) window.seekStep(only, t % window.STEPS[only]);\n            else window.seek(t % window.DURATION);\n            requestAnimationFrame(loop);\n          };\n          loop();\n        });\n    </script>\n  </body>\n</html>\n"
}