      "primary-hover": { "$value": "{color.palette.rich-black.900}", "$type": "color" },
      "primary-active": { "$value": "{color.palette.rich-black.800}", "$type": "color" },
      "primary-text": { "$value": "{color.palette.white}", "$type": "color" },
      "secondary": {
