        "via": { "$value": "{color.palette.keppel-green.500}", "$type": "color" },
        "to": { "$value": "{color.palette.cornflower-blue.100}", "$type": "color" }
      },
      "spectrum": {
        "$description": "4-stop dramatic: light → blue → purple → dark. For brand moments.",
        "stop-1": { "$value": "{color.palette.cornflower-blue.100}", "$type": "color" },
        "stop-2": { "$value": "{color.palette.cornflower-blue.400}", "$type": "color" },
