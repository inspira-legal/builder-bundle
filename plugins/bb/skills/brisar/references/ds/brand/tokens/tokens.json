      "$description": "Surface hierarchy. Semantic — brand-agnostic. Sub-brands remap these to their own primitives.",
      "primary": { "$value": "{color.palette.white}", "$type": "color" },
      "secondary": { "$value": "{color.palette.cool-gray.50}", "$type": "color" },
      "tertiary": { "$value": "{color.palette.cool-gray.100}", "$type": "color" },
